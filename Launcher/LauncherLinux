#!/usr/bin/env bash

set -Eeuo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
NC=$'\033[0m'

log()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()   { echo -e "${GREEN}[ OK ]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERR ]${NC} $*" >&2; }

trap 'err "Script failed at line $LINENO, exiting."; exit 1' ERR
export DEBIAN_FRONTEND=noninteractive

if [[ $EUID -ne 0 ]]; then
  err "Please run this script as root or with sudo."
  exit 1
fi

# ============================================================
# Existing: distro detection
# ============================================================
detect_distro() {
  if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    DISTRO_ID="${ID:-unknown}"
    DISTRO_LIKE="${ID_LIKE:-}"
  else
    err "Cannot find /etc/os-release, unsupported Linux distribution."
    exit 1
  fi
  case "$DISTRO_ID $DISTRO_LIKE" in
    *debian*|*ubuntu*) PKG_FAMILY="debian" ;;
    *rhel*|*fedora*|*centos*) PKG_FAMILY="rhel" ;;
    *) err "Unsupported distribution: ID=$DISTRO_ID, ID_LIKE=$DISTRO_LIKE"; exit 1 ;;
  esac
  log "Detected distro family: $PKG_FAMILY (ID=$DISTRO_ID)"
}

have_cmd() { command -v "$1" &>/dev/null; }

c_ready()      { have_cmd gcc && have_cmd make; }
java_ready()   { have_cmd java && have_cmd javac; }
python_ready() { have_cmd python3 && have_cmd pip3; }
figlet_ready() { have_cmd figlet; }

# ============================================================
# New: resolve project root (walk up to find DDOS/)
# ============================================================
resolve_project_root() {
  local start="${1:-$(pwd)}"
  local dir="$start"
  local i=0
  while [[ -n "$dir" && $i -lt 8 ]]; do
    if [[ -d "$dir/DDOS" ]]; then
      echo "$dir"
      return 0
    fi
    local parent
    parent="$(dirname "$dir")"
    if [[ "$parent" == "$dir" ]]; then
      break
    fi
    dir="$parent"
    i=$((i + 1))
  done
  return 1
}

# ============================================================
# New: execute selected file
# ============================================================
run_target_file() {
  local path="$1"
  local name="$2"
  local ext="${name##*.}"
  ext="$(echo "$ext" | tr '[:upper:]' '[:lower:]')"

  log "Preparing to run: $path"

  case "$ext" in
    py)
      if ! have_cmd python3; then
        err "python3 not found, cannot run."
        return 1
      fi
      ok "Executing: python3 \"$path\""
      python3 "$path"
      ;;

    java)
      if ! have_cmd javac || ! have_cmd java; then
        err "javac/java not found, cannot run."
        return 1
      fi
      # Extract public class name from source
      local class_name
      class_name="$(grep -oE '^[[:space:]]*public[[:space:]]+(final[[:space:]]+)?class[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' "$path" \
                    | head -1 \
                    | awk '{print $NF}')"
      if [[ -z "$class_name" ]]; then
        class_name="$(basename "$name" .java)"
      fi
      local workdir
      workdir="$(dirname "$path")"
      pushd "$workdir" >/dev/null
      ok "Compiling: javac \"$path\""
      if ! javac "$path"; then
        err "javac compilation failed."
        popd >/dev/null
        return 1
      fi
      ok "Executing: java $class_name"
      java "$class_name"
      popd >/dev/null
      ;;

    c)
      # Detect Windows vs Linux C source
      local is_windows_c=0
      local is_linux_c=0
      if grep -qE '#include[[:space:]]*[<"][[:space:]]*(windows\.h|winsock2\.h)' "$path"; then
        is_windows_c=1
      fi
      if grep -qE '#include[[:space:]]*[<"][[:space:]]*(sys/socket\.h|pthread\.h|netinet/in\.h)' "$path"; then
        is_linux_c=1
      fi

      if [[ $is_windows_c -eq 1 && $is_linux_c -eq 0 ]]; then
        warn "This file appears to be Windows-only C code and cannot be compiled directly on Linux."
        log "Run it on Windows with LauncherWindows, or compile it under MinGW."
        return 1
      fi

      if ! have_cmd gcc; then
        err "gcc not found, cannot compile."
        return 1
      fi

      local exe_path
      exe_path="${path%.c}"
      local workdir
      workdir="$(dirname "$path")"
      pushd "$workdir" >/dev/null
      if [[ $is_linux_c -eq 1 ]]; then
        ok "Compiling: gcc -O3 -pthread -o \"$exe_path\" \"$path\""
        if ! gcc -O3 -pthread -finput-charset=UTF-8 -o "$exe_path" "$path"; then
          err "gcc compilation failed."
          popd >/dev/null
          return 1
        fi
      else
        ok "Compiling: gcc -O3 -o \"$exe_path\" \"$path\""
        if ! gcc -O3 -finput-charset=UTF-8 -o "$exe_path" "$path"; then
          err "gcc compilation failed."
          popd >/dev/null
          return 1
        fi
      fi
      ok "Executing: $exe_path"
      "$exe_path"
      popd >/dev/null
      ;;

    *)
      err "Unsupported file type: .$ext"
      return 1
      ;;
  esac
}

# ============================================================
# New: scan + numbered menu
# ============================================================
start_run_menu() {
  local root="$1"
  local -a names=()
  local -a paths=()
  local -a langs=()
  local -a exts=()

  # Chinese first, English second
  local dirs=("$root/DDOS/Chinese:Chinese" "$root/DDOS/English:English")

  for entry in "${dirs[@]}"; do
    local dir="${entry%%:*}"
    local lang="${entry##*:}"
    [[ -d "$dir" ]] || continue
    # Sort by filename
    while IFS= read -r -d '' file; do
      names+=("$(basename "$file")")
      paths+=("$file")
      langs+=("$lang")
      exts+=("${file##*.}")
    done < <(find "$dir" -maxdepth 1 -type f \( -name '*.py' -o -name '*.c' -o -name '*.java' \) -print0 | sort -z)
  done

  if [[ ${#names[@]} -eq 0 ]]; then
    warn "No .py / .c / .java files found under $root/DDOS."
    return 1
  fi

  echo
  echo -e "${GREEN}================ Select a file to run ================${NC}"
  local i
  for i in "${!names[@]}"; do
    printf " %2d) %-32s (%s, .%s)\n" $((i + 1)) "${names[$i]}" "${langs[$i]}" "${exts[$i]}"
  done
  echo "  0) Exit"
  echo -e "${GREEN}======================================================${NC}"

  local choice
  while true; do
    read -r -p "[?] Enter number: " choice
    if [[ "$choice" == "0" ]]; then
      log "Exited."
      return 0
    fi
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#names[@]} )); then
      local idx=$((choice - 1))
      echo
      run_target_file "${paths[$idx]}" "${names[$idx]}" || true
      echo
      ok "File execution finished."
      return 0
    fi
    err "Invalid input, enter 1-${#names[@]} or 0 to exit."
  done
}

# ============================================================
# Stage 1: Detect
# ============================================================
detect_distro

log "===== Stage 1: Detect installed components (no downloads) ====="
MISSING=()
NEED_EPEL=0

if c_ready; then
  ok "C toolchain already present (gcc, make), skipping."
else
  warn "C toolchain missing: gcc=$(have_cmd gcc && echo Y || echo N)  make=$(have_cmd make && echo Y || echo N)"
  MISSING+=("c_toolchain")
fi

if java_ready; then
  ok "Java already present: $(java -version 2>&1 | head -1), skipping."
else
  warn "Java missing (java/javac incomplete)."
  MISSING+=("java")
fi

if python_ready; then
  ok "Python already present: $(python3 --version 2>&1), pip3=$(pip3 --version 2>&1 | cut -d' ' -f1-2), skipping."
else
  warn "Python missing (python3/pip3 incomplete)."
  MISSING+=("python")
fi

if figlet_ready; then
  ok "figlet already present, skipping."
else
  warn "figlet missing."
  MISSING+=("figlet")
  [[ "$PKG_FAMILY" == "rhel" ]] && NEED_EPEL=1
fi

# ------------------------------------------------------------
# Case A: everything present -> go straight to run menu
# ------------------------------------------------------------
if [[ ${#MISSING[@]} -eq 0 ]]; then
  echo
  ok "All target components already installed. Nothing to download."
  echo
  figlet -f small "All Ready" 2>/dev/null || echo "All Ready"

  # Refresh bash command hash
  hash -r 2>/dev/null || true

  START_DIR="$(pwd)"
  if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -d "$SCRIPT_DIR/DDOS" ]]; then
      START_DIR="$SCRIPT_DIR"
    fi
  fi

  echo
  log "===== Stage 3: Select a file to run ====="

  if PROJECT_ROOT="$(resolve_project_root "$START_DIR")"; then
    ok "Project root: $PROJECT_ROOT"
    start_run_menu "$PROJECT_ROOT"
  else
    warn "DDOS subdirectory not found, skipping run menu."
    log "Place this script in the DDOS-Attack project root (the one containing DDOS/) and retry, or cd to the project root first."
  fi
  exit 0
fi

# ============================================================
# Stage 2: Install
# ============================================================
log "Missing items: ${MISSING[*]}"
log "===== Stage 2: Install missing components ====="

pkg_update() {
  log "Updating package index..."
  if [[ "$PKG_FAMILY" == "debian" ]]; then
    apt-get update -qq
  else
    dnf makecache -y -q 2>/dev/null || yum makecache -y -q
  fi
}

pkg_install() {
  local pkgs=("$@")
  log "Installing: ${pkgs[*]}"
  if [[ "$PKG_FAMILY" == "debian" ]]; then
    apt-get install -y -qq "${pkgs[@]}"
  else
    dnf install -y -q "${pkgs[@]}" 2>/dev/null || yum install -y -q "${pkgs[@]}"
  fi
}

install_item() {
  local item="$1"
  case "$item" in
    c_toolchain)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        pkg_install build-essential
      else
        have_cmd gcc || pkg_install gcc
        have_cmd make || pkg_install make
      fi
      ;;
    java)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        pkg_install default-jdk
      else
        pkg_install java-latest-openjdk-devel 2>/dev/null || pkg_install java-17-openjdk-devel
      fi
      ;;
    python)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        have_cmd python3 || pkg_install python3
        have_cmd pip3   || pkg_install python3-pip
      else
        have_cmd python3 || pkg_install python3
        have_cmd pip3   || pkg_install python3-pip
      fi
      ;;
    figlet)
      if [[ "$PKG_FAMILY" == "rhel" ]] && [[ $NEED_EPEL -eq 1 ]]; then
        if ! rpm -q epel-release &>/dev/null; then
          pkg_install epel-release 2>/dev/null || true
        fi
      fi
      pkg_install figlet
      ;;
  esac
}

pkg_update
for item in "${MISSING[@]}"; do
  install_item "$item"
done

# ============================================================
# Installation summary
# ============================================================
echo
echo -e "${GREEN}================ Install summary ================${NC}"
printf "  %-12s : %s\n" "gcc"    "$(gcc --version 2>/dev/null | head -1 || echo 'not installed')"
printf "  %-12s : %s\n" "make"   "$(make --version 2>/dev/null | head -1 || echo 'not installed')"
printf "  %-12s : %s\n" "java"   "$(java -version 2>&1 | head -1 || echo 'not installed')"
printf "  %-12s : %s\n" "javac"  "$(javac -version 2>&1 || echo 'not installed')"
printf "  %-12s : %s\n" "python3" "$(python3 --version 2>&1 || echo 'not installed')"
printf "  %-12s : %s\n" "pip3"   "$(pip3 --version 2>&1 | cut -d' ' -f1-2 || echo 'not installed')"
printf "  %-12s : %s\n" "figlet" "$(figlet -v 2>&1 | head -1 || echo 'not installed')"
echo -e "${GREEN}=================================================${NC}"
echo
figlet -f small "Done" 2>/dev/null || echo "All done."

# ============================================================
# Stage 3: Select a file to run
# ============================================================
echo
log "===== Stage 3: Select a file to run ====="

# Refresh command hash
hash -r 2>/dev/null || true

START_DIR="$(pwd)"
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -d "$SCRIPT_DIR/DDOS" ]]; then
    START_DIR="$SCRIPT_DIR"
  fi
fi

if PROJECT_ROOT="$(resolve_project_root "$START_DIR")"; then
  ok "Project root: $PROJECT_ROOT"
  start_run_menu "$PROJECT_ROOT"
else
  warn "DDOS subdirectory not found in current or script directory."
  log "Place this script in the DDOS-Attack project root (the one containing DDOS/) and re-run."
  log "Or cd to the project root manually and run again."
  exit 0
fi
