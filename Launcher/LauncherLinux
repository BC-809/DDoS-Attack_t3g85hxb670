#!/usr/bin/env bash

set -Eeuo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
NC=$'\033[0m'

log()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()   { echo -e "${GREEN}[ OK ]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERR ]${NC} $*" >&2; }

trap 'err "脚本在第 $LINENO 行出错，退出。"; exit 1' ERR
export DEBIAN_FRONTEND=noninteractive

if [[ $EUID -ne 0 ]]; then
  err "请使用 root 或 sudo 运行此脚本。"
  exit 1
fi

# ============================================================
# 原有：发行版检测
# ============================================================
detect_distro() {
  if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    DISTRO_ID="${ID:-unknown}"
    DISTRO_LIKE="${ID_LIKE:-}"
  else
    err "无法找到 /etc/os-release，不支持的 Linux 发行版。"
    exit 1
  fi
  case "$DISTRO_ID $DISTRO_LIKE" in
    *debian*|*ubuntu*) PKG_FAMILY="debian" ;;
    *rhel*|*fedora*|*centos*) PKG_FAMILY="rhel" ;;
    *) err "暂不支持该发行版: ID=$DISTRO_ID, ID_LIKE=$DISTRO_LIKE"; exit 1 ;;
  esac
  log "检测到发行版族: $PKG_FAMILY (ID=$DISTRO_ID)"
}

have_cmd() { command -v "$1" &>/dev/null; }

c_ready()      { have_cmd gcc && have_cmd make; }
java_ready()   { have_cmd java && have_cmd javac; }
python_ready() { have_cmd python3 && have_cmd pip3; }
figlet_ready() { have_cmd figlet; }

# ============================================================
# 新增：项目根目录定位（从当前目录向上找含 DDOS/ 的目录）
# ============================================================
resolve_project_root() {
  local start="${1:-$(pwd)}"
  local dir="$start"
  local i=0
  while [[ -n "$dir" && $i -lt 8 ]]; do
    if [[ -d "$dir/DDOS" ]]; then
      echo "$dir"
      return 0
    fi
    local parent
    parent="$(dirname "$dir")"
    if [[ "$parent" == "$dir" ]]; then
      break
    fi
    dir="$parent"
    i=$((i + 1))
  done
  return 1
}

# ============================================================
# 新增：按文件类型执行
# ============================================================
run_target_file() {
  local path="$1"
  local name="$2"
  local ext="${name##*.}"
  ext="$(echo "$ext" | tr '[:upper:]' '[:lower:]')"

  log "准备运行：$path"

  case "$ext" in
    py)
      if ! have_cmd python3; then
        err "未找到 python3，无法运行。"
        return 1
      fi
      ok "执行: python3 \"$path\""
      python3 "$path"
      ;;

    java)
      if ! have_cmd javac || ! have_cmd java; then
        err "未找到 javac/java，无法运行。"
        return 1
      fi
      # 从源码提取 public class 名
      local class_name
      class_name="$(grep -oE '^[[:space:]]*public[[:space:]]+(final[[:space:]]+)?class[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' "$path" \
                    | head -1 \
                    | awk '{print $NF}')"
      if [[ -z "$class_name" ]]; then
        class_name="$(basename "$name" .java)"
      fi
      local workdir
      workdir="$(dirname "$path")"
      pushd "$workdir" >/dev/null
      ok "编译: javac \"$path\""
      if ! javac "$path"; then
        err "javac 编译失败。"
        popd >/dev/null
        return 1
      fi
      ok "执行: java $class_name"
      java "$class_name"
      popd >/dev/null
      ;;

    c)
      # 判断是 Windows 版还是 Linux 版 C 代码
      local is_windows_c=0
      local is_linux_c=0
      if grep -qE '#include[[:space:]]*[<"][[:space:]]*(windows\.h|winsock2\.h)' "$path"; then
        is_windows_c=1
      fi
      if grep -qE '#include[[:space:]]*[<"][[:space:]]*(sys/socket\.h|pthread\.h|netinet/in\.h)' "$path"; then
        is_linux_c=1
      fi

      if [[ $is_windows_c -eq 1 && $is_linux_c -eq 0 ]]; then
        warn "该文件看起来是 Windows 专用 C 代码，Linux 下无法直接编译运行。"
        log "请在 Windows 下使用 LauncherWindows 运行，或在 MinGW 环境中编译。"
        return 1
      fi

      if ! have_cmd gcc; then
        err "未找到 gcc，无法编译。"
        return 1
      fi

      local exe_path
      exe_path="${path%.c}"
      local workdir
      workdir="$(dirname "$path")"
      pushd "$workdir" >/dev/null
      if [[ $is_linux_c -eq 1 ]]; then
        ok "编译: gcc -O3 -pthread -o \"$exe_path\" \"$path\""
        if ! gcc -O3 -pthread -finput-charset=UTF-8 -o "$exe_path" "$path"; then
          err "gcc 编译失败。"
          popd >/dev/null
          return 1
        fi
      else
        ok "编译: gcc -O3 -o \"$exe_path\" \"$path\""
        if ! gcc -O3 -finput-charset=UTF-8 -o "$exe_path" "$path"; then
          err "gcc 编译失败。"
          popd >/dev/null
          return 1
        fi
      fi
      ok "执行: $exe_path"
      "$exe_path"
      popd >/dev/null
      ;;

    *)
      err "不支持的文件类型：.$ext"
      return 1
      ;;
  esac
}

# ============================================================
# 新增：扫描 + 编号菜单
# ============================================================
start_run_menu() {
  local root="$1"
  local -a names=()
  local -a paths=()
  local -a langs=()
  local -a exts=()

  # 中文在前，英文在后
  local dirs=("$root/DDOS/Chinese:中文" "$root/DDOS/English:英文")

  for entry in "${dirs[@]}"; do
    local dir="${entry%%:*}"
    local lang="${entry##*:}"
    [[ -d "$dir" ]] || continue
    # 按文件名排序
    while IFS= read -r -d '' file; do
      names+=("$(basename "$file")")
      paths+=("$file")
      langs+=("$lang")
      exts+=("${file##*.}")
    done < <(find "$dir" -maxdepth 1 -type f \( -name '*.py' -o -name '*.c' -o -name '*.java' \) -print0 | sort -z)
  done

  if [[ ${#names[@]} -eq 0 ]]; then
    warn "在 $root/DDOS 下未找到可运行的 .py / .c / .java 文件。"
    return 1
  fi

  echo
  echo -e "${GREEN}================ 选择要运行的文件 ================${NC}"
  local i
  for i in "${!names[@]}"; do
    printf " %2d) %-32s (%s, .%s)\n" $((i + 1)) "${names[$i]}" "${langs[$i]}" "${exts[$i]}"
  done
  echo "  0) 退出"
  echo -e "${GREEN}====================================================${NC}"

  local choice
  while true; do
    read -r -p "[?] 请输入编号: " choice
    if [[ "$choice" == "0" ]]; then
      log "已退出。"
      return 0
    fi
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#names[@]} )); then
      local idx=$((choice - 1))
      echo
      run_target_file "${paths[$idx]}" "${names[$idx]}" || true
      echo
      ok "该文件已结束运行。"
      return 0
    fi
    err "无效输入，请输入 1-${#names[@]} 或 0 退出。"
  done
}

# ============================================================
# 阶段 1：检测
# ============================================================
detect_distro

log "===== 阶段 1：检测已安装组件（不下载） ====="
MISSING=()
NEED_EPEL=0

if c_ready; then
  ok "C 工具链已存在（gcc, make），跳过。"
else
  warn "C 工具链缺失：gcc=$(have_cmd gcc && echo Y || echo N)  make=$(have_cmd make && echo Y || echo N)"
  MISSING+=("c_toolchain")
fi

if java_ready; then
  ok "Java 已存在：$(java -version 2>&1 | head -1)，跳过。"
else
  warn "Java 缺失（java/javac 不完整）。"
  MISSING+=("java")
fi

if python_ready; then
  ok "Python 已存在：$(python3 --version 2>&1)，pip3=$(pip3 --version 2>&1 | cut -d' ' -f1-2)，跳过。"
else
  warn "Python 缺失（python3/pip3 不完整）。"
  MISSING+=("python")
fi

if figlet_ready; then
  ok "figlet 已存在，跳过。"
else
  warn "figlet 缺失。"
  MISSING+=("figlet")
  [[ "$PKG_FAMILY" == "rhel" ]] && NEED_EPEL=1
fi

# ------------------------------------------------------------
# 情况 A：全部齐全 → 直接进入运行菜单
# ------------------------------------------------------------
if [[ ${#MISSING[@]} -eq 0 ]]; then
  echo
  ok "所有目标组件均已安装，无需下载任何内容。"
  echo
  figlet -f small "All Ready" 2>/dev/null || echo "All Ready"

  # 刷新 bash 的 command hash（不必须，但保险）
  hash -r 2>/dev/null || true

  START_DIR="$(pwd)"
  # 如果脚本是通过绝对路径调用的，优先用脚本所在目录
  if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -d "$SCRIPT_DIR/DDOS" ]]; then
      START_DIR="$SCRIPT_DIR"
    fi
  fi

  echo
  log "===== 阶段 3：选择要运行的文件 ====="

  if PROJECT_ROOT="$(resolve_project_root "$START_DIR")"; then
    ok "项目根目录：$PROJECT_ROOT"
    start_run_menu "$PROJECT_ROOT"
  else
    warn "未找到 DDOS 子目录，跳过运行菜单。"
    log "请将本脚本放在 DDOS-Attack 项目根目录（含 DDOS/）后重试，或先 cd 到项目根目录。"
  fi
  exit 0
fi

# ============================================================
# 阶段 2：安装
# ============================================================
log "待安装项：${MISSING[*]}"
log "===== 阶段 2：安装缺失组件 ====="

pkg_update() {
  log "更新包索引..."
  if [[ "$PKG_FAMILY" == "debian" ]]; then
    apt-get update -qq
  else
    dnf makecache -y -q 2>/dev/null || yum makecache -y -q
  fi
}

pkg_install() {
  local pkgs=("$@")
  log "安装: ${pkgs[*]}"
  if [[ "$PKG_FAMILY" == "debian" ]]; then
    apt-get install -y -qq "${pkgs[@]}"
  else
    dnf install -y -q "${pkgs[@]}" 2>/dev/null || yum install -y -q "${pkgs[@]}"
  fi
}

install_item() {
  local item="$1"
  case "$item" in
    c_toolchain)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        pkg_install build-essential
      else
        have_cmd gcc || pkg_install gcc
        have_cmd make || pkg_install make
      fi
      ;;
    java)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        pkg_install default-jdk
      else
        pkg_install java-latest-openjdk-devel 2>/dev/null || pkg_install java-17-openjdk-devel
      fi
      ;;
    python)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        have_cmd python3 || pkg_install python3
        have_cmd pip3   || pkg_install python3-pip
      else
        have_cmd python3 || pkg_install python3
        have_cmd pip3   || pkg_install python3-pip
      fi
      ;;
    figlet)
      if [[ "$PKG_FAMILY" == "rhel" ]] && [[ $NEED_EPEL -eq 1 ]]; then
        if ! rpm -q epel-release &>/dev/null; then
          pkg_install epel-release 2>/dev/null || true
        fi
      fi
      pkg_install figlet
      ;;
  esac
}

pkg_update
for item in "${MISSING[@]}"; do
  install_item "$item"
done

# ============================================================
# 安装汇总
# ============================================================
echo
echo -e "${GREEN}================ 安装汇总 ================${NC}"
printf "  %-12s : %s\n" "gcc"    "$(gcc --version 2>/dev/null | head -1 || echo '未安装')"
printf "  %-12s : %s\n" "make"   "$(make --version 2>/dev/null | head -1 || echo '未安装')"
printf "  %-12s : %s\n" "java"   "$(java -version 2>&1 | head -1 || echo '未安装')"
printf "  %-12s : %s\n" "javac"  "$(javac -version 2>&1 || echo '未安装')"
printf "  %-12s : %s\n" "python3" "$(python3 --version 2>&1 || echo '未安装')"
printf "  %-12s : %s\n" "pip3"   "$(pip3 --version 2>&1 | cut -d' ' -f1-2 || echo '未安装')"
printf "  %-12s : %s\n" "figlet" "$(figlet -v 2>&1 | head -1 || echo '未安装')"
echo -e "${GREEN}=========================================${NC}"
echo
figlet -f small "Done" 2>/dev/null || echo "全部完成。"

# ============================================================
# 阶段 3：选择要运行的文件
# ============================================================
echo
log "===== 阶段 3：选择要运行的文件 ====="

# 刷新 command hash
hash -r 2>/dev/null || true

START_DIR="$(pwd)"
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -d "$SCRIPT_DIR/DDOS" ]]; then
    START_DIR="$SCRIPT_DIR"
  fi
fi

if PROJECT_ROOT="$(resolve_project_root "$START_DIR")"; then
  ok "项目根目录：$PROJECT_ROOT"
  start_run_menu "$PROJECT_ROOT"
else
  warn "未在当前目录或脚本目录中找到 DDOS 子目录。"
  log "请将本脚本放在 DDOS-Attack 项目根目录（含 DDOS/）后重新运行。"
  log "或手动 cd 到项目根目录后再执行。"
  exit 0
fi
