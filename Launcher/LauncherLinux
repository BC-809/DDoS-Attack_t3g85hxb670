#!/usr/bin/env bash
# ============================================================
# install-dev-tools.sh
# 一键安装 Java / Python / C / figlet
# 策略：先全量检测，已存在的完全不下载；仅对缺失项发起更新与安装
# 用法: sudo ./install-dev-tools.sh
# ============================================================

set -Eeuo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
NC=$'\033[0m'

log()  { echo -e "${BLUE}[INFO]${NC} $*"; }
ok()   { echo -e "${GREEN}[ OK ]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERR ]${NC} $*" >&2; }

trap 'err "脚本在第 $LINENO 行出错，退出。"; exit 1' ERR
export DEBIAN_FRONTEND=noninteractive

if [[ $EUID -ne 0 ]]; then
  err "请使用 root 或 sudo 运行此脚本。"
  exit 1
fi

# ---------- 发行版检测 ----------
detect_distro() {
  if [[ -f /etc/os-release ]]; then
    . /etc/os-release
    DISTRO_ID="${ID:-unknown}"
    DISTRO_LIKE="${ID_LIKE:-}"
  else
    err "无法找到 /etc/os-release，不支持的 Linux 发行版。"
    exit 1
  fi
  case "$DISTRO_ID $DISTRO_LIKE" in
    *debian*|*ubuntu*) PKG_FAMILY="debian" ;;
    *rhel*|*fedora*|*centos*) PKG_FAMILY="rhel" ;;
    *) err "暂不支持该发行版: ID=$DISTRO_ID, ID_LIKE=$DISTRO_LIKE"; exit 1 ;;
  esac
  log "检测到发行版族: $PKG_FAMILY (ID=$DISTRO_ID)"
}

# ---------- 检测函数 ----------
have_cmd() { command -v "$1" &>/dev/null; }

# C 工具链是否完整
c_ready() {
  have_cmd gcc && have_cmd make
}

# Java 是否完整（编译 + 运行）
java_ready() {
  have_cmd java && have_cmd javac
}

# Python 是否完整（解释器 + pip）
python_ready() {
  have_cmd python3 && have_cmd pip3
}

# figlet
figlet_ready() {
  have_cmd figlet
}

# ---------- 主流程 ----------
detect_distro

# 第一轮：全量检测，构建待安装列表
log "===== 阶段 1：检测已安装组件（不下载） ====="
MISSING=()
NEED_EPEL=0

if c_ready; then
  ok "C 工具链已存在（gcc, make），跳过。"
else
  warn "C 工具链缺失：gcc=$(have_cmd gcc && echo Y || echo N)  make=$(have_cmd make && echo Y || echo N)"
  MISSING+=("c_toolchain")
fi

if java_ready; then
  ok "Java 已存在：$(java -version 2>&1 | head -1)，跳过。"
else
  warn "Java 缺失（java/javac 不完整）。"
  MISSING+=("java")
fi

if python_ready; then
  ok "Python 已存在：$(python3 --version 2>&1)，pip3=$(pip3 --version 2>&1 | cut -d' ' -f1-2)，跳过。"
else
  warn "Python 缺失（python3/pip3 不完整）。"
  MISSING+=("python")
fi

if figlet_ready; then
  ok "figlet 已存在，跳过。"
else
  warn "figlet 缺失。"
  MISSING+=("figlet")
  [[ "$PKG_FAMILY" == "rhel" ]] && NEED_EPEL=1
fi

# 全部已安装：直接退出，零下载
if [[ ${#MISSING[@]} -eq 0 ]]; then
  echo
  ok "所有目标组件均已安装，无需下载任何内容。"
  echo
  figlet -f small "All Ready" 2>/dev/null || echo "All Ready"
  exit 0
fi

log "待安装项：${MISSING[*]}"

# 第二轮：仅在存在缺失时，才更新索引 + 安装
log "===== 阶段 2：安装缺失组件 ====="

pkg_update() {
  log "更新包索引..."
  if [[ "$PKG_FAMILY" == "debian" ]]; then
    apt-get update -qq
  else
    dnf makecache -y -q 2>/dev/null || yum makecache -y -q
  fi
}

pkg_install() {
  local pkgs=("$@")
  log "安装: ${pkgs[*]}"
  if [[ "$PKG_FAMILY" == "debian" ]]; then
    apt-get install -y -qq "${pkgs[@]}"
  else
    dnf install -y -q "${pkgs[@]}" 2>/dev/null || yum install -y -q "${pkgs[@]}"
  fi
}

# 按需安装：只对缺失项调用 pkg_install
install_item() {
  local item="$1"
  case "$item" in
    c_toolchain)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        pkg_install build-essential
      else
        have_cmd gcc || pkg_install gcc
        have_cmd make || pkg_install make
      fi
      ;;
    java)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        pkg_install default-jdk
      else
        pkg_install java-latest-openjdk-devel 2>/dev/null || pkg_install java-17-openjdk-devel
      fi
      ;;
    python)
      if [[ "$PKG_FAMILY" == "debian" ]]; then
        have_cmd python3 || pkg_install python3
        have_cmd pip3   || pkg_install python3-pip
      else
        have_cmd python3 || pkg_install python3
        have_cmd pip3   || pkg_install python3-pip
      fi
      ;;
    figlet)
      if [[ "$PKG_FAMILY" == "rhel" ]] && [[ $NEED_EPEL -eq 1 ]]; then
        if ! rpm -q epel-release &>/dev/null; then
          pkg_install epel-release 2>/dev/null || true
        fi
      fi
      pkg_install figlet
      ;;
  esac
}

pkg_update
for item in "${MISSING[@]}"; do
  install_item "$item"
done

# ---------- 汇总验证 ----------
echo
echo -e "${GREEN}================ 安装汇总 ================${NC}"
printf "  %-12s : %s\n" "gcc"    "$(gcc --version 2>/dev/null | head -1 || echo '未安装')"
printf "  %-12s : %s\n" "make"   "$(make --version 2>/dev/null | head -1 || echo '未安装')"
printf "  %-12s : %s\n" "java"   "$(java -version 2>&1 | head -1 || echo '未安装')"
printf "  %-12s : %s\n" "javac"  "$(javac -version 2>&1 || echo '未安装')"
printf "  %-12s : %s\n" "python3" "$(python3 --version 2>&1 || echo '未安装')"
printf "  %-12s : %s\n" "pip3"   "$(pip3 --version 2>&1 | cut -d' ' -f1-2 || echo '未安装')"
printf "  %-12s : %s\n" "figlet" "$(figlet -v 2>&1 | head -1 || echo '未安装')"
echo -e "${GREEN}=========================================${NC}"
echo
figlet -f small "Done" 2>/dev/null || echo "全部完成。"
